# Local Streamlit runtime
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8765
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Limit native model workers for a responsive demo UI
OMP_NUM_THREADS=1
LOKY_MAX_CPU_COUNT=1

# Demo streams: paysim (bundled), amlworld (2 days), amlworld_tuned (4 days),
# or amlworld_full (default). Setup is in README.md.
# loop repeats the entire source. replay reads the held-out CSV once.
# live consumes producer events. recorded opens the bundled Haituo hardware session.
QFG_SOURCE=loop
# QFG_REPLAY_SOURCE=data/downloads/ibm_amlworld.zip
# QFG_REPLAY_INDEX=artifacts/amlworld_full-replay.sqlite
# QFG_REPLAY_BATCH=64
# QFG_REPLAY_INTERVAL=1
# Set to 1 when scripts/stream.py replay-loop owns ingestion.
# QFG_REPLAY_EXTERNAL=0
# Set to 1 in the dashboard when scripts/stream.py prioritize handles windows.
# QFG_EXTERNAL_PRIORITY=0
# Defaults to artifacts/operations.sqlite3 and <source>-<dataset>.
# QFG_CASE_DB=
# QFG_STREAM=
# Dashboard demo login overrides. Set them in the Streamlit process environment.
# QFG_DASHBOARD_OPERATOR_PASSWORD=
# QFG_DASHBOARD_ADMIN_PASSWORD=
# Operator name for backend changes through the CLI.
# QFG_OPERATOR=
# Core Banking API requires explicit QFG_CASE_DB, QFG_STREAM and QFG_MODEL_PATH.
# Set separate API credentials through the bank's secrets store.
# QFG_CORE_INGEST_TOKEN=
# QFG_CORE_RECEIPTS_TOKEN=
# QFG_CORE_READ_TOKEN=
# The host ranks windows locally. Operators can change the backend using scripts/stream.py set-backend.
QFG_PRIORITY_MODE=qubo
QFG_DATASET=amlworld_full
# With max normalization the largest risk in the window is 1. Each selected
# pair sharing an account earns 0.01 * 0.5 = 0.005 in the benchmark.
QFG_RISK_NORMALIZATION=max
QFG_CONNECTIVITY_STRENGTH=0.01

# QUBO backend. sqa and exact run locally on CPU. Other choices are listed below.
#   dwave-qpu    real D-Wave annealing QPU via Leap (needs DWAVE_API_TOKEN)
#   dwave-hybrid Leap hybrid CQM solver (needs DWAVE_API_TOKEN, >= 5 s per job)
#   dwave-mock   offline simulator of the QPU code path (NOT quantum hardware)
#   quafu-qpu    real Quafu-SQC superconducting QPU (needs QPU_API_TOKEN; run with
#                .venv-quafu\Scripts\python, see docs/TRIEN_KHAI_QPU.md)
#   quafu-mock   the same QAOA circuits on a local noiseless simulator (NOT quantum hardware)
#   quafu-fast-qpu / quafu-fast-mock  one-layer warm-start circuit, 1024 shots per job.
#                The dashboard stops at the first certified hit or its measurement limit.
#   quafu-anneal-qpu / quafu-anneal-mock  digitized transverse-field annealing on the
#                full D-Wave QUBO, using Quafu hardware or the local simulator
QFG_SOLVER=exact

# D-Wave Leap credentials (https://cloud.dwavesys.com/leap -> API Token).
# Never commit a real token; .env is git-ignored.
DWAVE_API_TOKEN=
# Optional: pin a QPU, e.g. Advantage_system4.1 or Advantage2_system1.x
DWAVE_SOLVER=

# Quafu-SQC credentials (https://quafu-sqc.baqis.ac.cn). Never commit a real token.
QPU_API_TOKEN=
QFG_QUAFU_CHIP=Haituo
QFG_QUAFU_BACKUP_CHIP=Baihua
QFG_QUAFU_SHOTS=2048
QFG_QAOA_LAYERS=3
QFG_QUAFU_ANNEAL_STEPS=3
QFG_QUAFU_ANNEAL_DURATION=2.0
QFG_QUAFU_MAX_QUBITS=12
QFG_QUAFU_FAST_MAX_QUBITS=18
# Illustrative full preparation, circuit, readout and reset cycle for sampling estimates (microseconds).
QFG_QUAFU_ASSUMED_SHOT_PERIOD_US=100

# Cap on cumulative QPU access time per dashboard process before falling back
# to QFG_SOLVER_FALLBACK (protects a Leap trial allocation). Use "none" to
# disable the fallback entirely.
# This example caps fallback-enabled solvers at 10 s. When unset, the code uses
# 10 s for D-Wave and 600 s for Quafu.
QFG_QPU_BUDGET_SECONDS=10
QFG_SOLVER_FALLBACK=sqa
QFG_QPU_NUM_READS=100
QFG_QPU_ANNEALING_TIME_US=
QFG_QPU_CHAIN_STRENGTH=
QFG_HYBRID_TIME_LIMIT_S=

# Candidate windowing for QUBO jobs: submit when MIN_BATCH candidates are
# waiting or the oldest has waited WINDOW_SECONDS; at most MAX_BATCH per job.
# The dashboard defaults to 18 for fast Quafu and 8 for other Quafu modes.
# The launcher can set both limits explicitly with -WindowSize.
# QFG_QUANTUM_MIN_BATCH=8
# QFG_QUANTUM_MAX_BATCH=40
QFG_QUANTUM_WINDOW_SECONDS=10
# Per window attempt, per window, and result acceptance deadline per attempt.
QFG_WINDOW_MAX_JOBS=8
QFG_WINDOW_MAX_ATTEMPTS=3
QFG_WINDOW_TIMEOUT_SECONDS=180
