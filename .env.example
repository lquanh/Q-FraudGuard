# Local Streamlit runtime
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8765
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Limit native model workers for a responsive demo UI
OMP_NUM_THREADS=1
LOKY_MAX_CPU_COUNT=1

# QUBO backend: sqa | exact | dwave-qpu | dwave-hybrid | dwave-mock
#   dwave-qpu    real D-Wave annealing QPU via Leap (needs DWAVE_API_TOKEN)
#   dwave-hybrid Leap hybrid CQM solver (needs DWAVE_API_TOKEN, >= 5 s per job)
#   dwave-mock   offline simulator of the QPU code path (NOT quantum hardware)
QFG_SOLVER=sqa

# D-Wave Leap credentials (https://cloud.dwavesys.com/leap -> API Token).
# Never commit a real token; .env is git-ignored.
DWAVE_API_TOKEN=
# Optional: pin a QPU, e.g. Advantage_system4.1 or Advantage2_system1.x
DWAVE_SOLVER=

# Cap on cumulative QPU access time per dashboard process before falling back
# to QFG_SOLVER_FALLBACK (protects a Leap trial allocation). Use "none" to
# disable the fallback entirely.
QFG_QPU_BUDGET_SECONDS=10
QFG_SOLVER_FALLBACK=sqa
QFG_QPU_NUM_READS=100
QFG_QPU_ANNEALING_TIME_US=
QFG_QPU_CHAIN_STRENGTH=
QFG_HYBRID_TIME_LIMIT_S=

# Candidate windowing for QUBO jobs: submit when MIN_BATCH candidates are
# waiting or the oldest has waited WINDOW_SECONDS; at most MAX_BATCH per job.
QFG_QUANTUM_MIN_BATCH=8
QFG_QUANTUM_MAX_BATCH=40
QFG_QUANTUM_WINDOW_SECONDS=10
